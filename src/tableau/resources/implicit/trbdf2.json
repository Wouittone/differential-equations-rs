{
  "$schema"          : "../schema.json",
  "name"             : "Trbdf2",
  "description"      : "Hosea-Shampine TR-BDF2 with its third-order companion and Newton stage predictors; direct error uses the SciML b_hat - b convention.",
  "kind"             : "implicit-runge-kutta",
  "order"            : 2,
  "embedded_order"   : 3,
  "fsal"             : true,
  "A"                : [
    [0, 0, 0],
    ["1 - sqrt(2) / 2", "1 - sqrt(2) / 2", 0],
    ["sqrt(2) / 4", "sqrt(2) / 4", "1 - sqrt(2) / 2"]
  ],
  "b"                : ["sqrt(2) / 4", "sqrt(2) / 4", "1 - sqrt(2) / 2"],
  "c"                : [0, "2 - sqrt(2)", 1],
  "error"            : ["(1 - sqrt(2)) / 3", "1 / 3", "(sqrt(2) - 2) / 3"],
  "stage_predictors" : [
    [],
    [1],
    ["-sqrt(2) / 2", "1 + sqrt(2) / 2"]
  ]
}
