{
  "$schema"     : "../variable-multistep-schema.json",
  "name"        : "Abdf2",
  "description" : "Adaptive fixed-leading-coefficient variable-step BDF2 formula ported from OrdinaryDiffEqBDF.",
  "kind"        : "variable-linear-multistep",
  "order"       : 2,
  "alpha"       : [
    [1],
    [-1, 0, "-1 / 3"],
    [0, 0, "1 / 3"]
  ],
  "beta"        : [
    ["2 / 3"],
    ["1 / 3", "-1 / 3"],
    [0]
  ],
  "startup"     : {
    "order" : 1,
    "alpha" : [1, -1],
    "beta"  : [1, 0]
  },
  "defect"      : {
    "derivative_weights" : [
      [1],
      [-1, -1],
      [0, 1]
    ],
    "scale"              : { "numerator": [1, 1], "denominator": [0, 6] }
  }
}
