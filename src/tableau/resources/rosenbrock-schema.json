{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transformed Rosenbrock tableau",
  "description": "Runtime validation also checks matrix dimensions, causality, coefficient finiteness and Richardson method_order equality with order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "kind", "order", "gamma", "A", "C", "c", "d", "b"],
  "properties": {
    "$schema": {"type": ["string", "null"]},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "kind": {"enum": ["rosenbrock", "hybrid-explicit-implicit"]},
    "order": {"type": "integer", "minimum": 1},
    "gamma": {"$ref": "#/$defs/scalar"},
    "A": {"$ref": "#/$defs/matrix"},
    "C": {"$ref": "#/$defs/matrix"},
    "c": {"$ref": "#/$defs/vector"},
    "d": {"$ref": "#/$defs/vector"},
    "b": {"$ref": "#/$defs/vector"},
    "btilde": {"oneOf": [{"$ref": "#/$defs/vector"}, {"type": "null"}]},
    "H": {"type": "array", "items": {"$ref": "#/$defs/vector"}},
    "error_estimator": {
      "default": {"kind": "embedded"},
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "embedded"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "method_order"], "properties": {"kind": {"const": "richardson-step-doubling"}, "method_order": {"type": "integer", "minimum": 1}}}
      ]
    }
  },
  "allOf": [{"if": {"required": ["error_estimator"], "properties": {"error_estimator": {"properties": {"kind": {"const": "richardson-step-doubling"}}}}}, "then": {"properties": {"kind": {"const": "rosenbrock"}}}}],
  "$defs": {
    "scalar": {"oneOf": [{"type": "number"}, {"type": "string", "minLength": 1}]},
    "vector": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}},
    "matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vector"}}
  }
}
