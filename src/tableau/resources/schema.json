{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Wouittone/differential-equations-rs/blob/main/src/tableau/resources/schema.json",
  "title": "Differential equations Runge–Kutta tableau",
  "description": "Canonical Butcher tableau resource consumed by differential-equations-rs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "kind", "order", "A", "b", "c"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "default": "../schema.json"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["explicit-runge-kutta", "implicit-runge-kutta"]
    },
    "order": { "type": "integer", "minimum": 1 },
    "embedded_order": { "type": "integer", "minimum": 1 },
    "fsal": { "type": "boolean", "default": false },
    "A": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    },
    "b": { "$ref": "#/$defs/vector" },
    "b_hat": {
      "$ref": "#/$defs/vector",
      "description": "Embedded weights; the parser derives error = b - b_hat. Mutually exclusive with error."
    },
    "c": { "$ref": "#/$defs/vector" },
    "error": { "$ref": "#/$defs/vector" },
    "second_error": { "$ref": "#/$defs/vector" },
    "stage_predictors": {
      "type": "array",
      "description": "Implicit-stage initial guesses. Each row weights prior stage derivatives; an empty row uses the driver's default predictor.",
      "items": { "type": "array", "items": { "$ref": "#/$defs/scalar" } }
    },
    "dense": {
      "type": "array",
      "items": { "$ref": "#/$defs/vector" }
    },
    "lazy_dense_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["c", "A"],
        "properties": {
          "c": { "$ref": "#/$defs/scalar" },
          "A": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["stage", "value"],
              "properties": {
                "stage": { "type": "integer", "minimum": 0 },
                "value": { "$ref": "#/$defs/scalar" }
              }
            }
          }
        }
      }
    },
    "fitted_weights": {
      "type": "array",
      "description": "Primary weights represented by rational polynomials in a solver-defined runtime fit variable.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "numerator", "denominator"],
        "properties": {
          "stage": { "type": "integer", "minimum": 0 },
          "numerator": { "$ref": "#/$defs/vector" },
          "denominator": { "$ref": "#/$defs/vector" }
        }
      }
    }
  },
  "allOf": [
    { "not": { "required": ["error", "b_hat"] } },
    {
      "if": { "required": ["stage_predictors"], "properties": { "stage_predictors": { "minItems": 1 } } },
      "then": { "properties": { "kind": { "const": "implicit-runge-kutta" } } }
    },
    {
      "if": { "required": ["embedded_order"] },
      "then": { "oneOf": [{ "required": ["error"] }, { "required": ["b_hat"] }] },
      "else": { "not": { "anyOf": [{ "required": ["error"] }, { "required": ["b_hat"] }] } }
    }
  ],
  "$defs": {
    "scalar": {
      "description": "A JSON number or an exact-style arithmetic expression such as \"(3 - sqrt(3)) / 6\".",
      "oneOf": [
        { "type": "number" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "vector": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scalar" }
    }
  }
}
