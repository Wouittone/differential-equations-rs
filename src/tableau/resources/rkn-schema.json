{
  "$schema"              : "https://json-schema.org/draft/2020-12/schema",
  "$id"                  : "https://github.com/Wouittone/differential-equations-rs/blob/main/src/tableau/resources/rkn-schema.json",
  "title"                : "Runge--Kutta--Nystrom tableau",
  "type"                 : "object",
  "additionalProperties" : false,
  "required"             : ["name", "kind", "order", "A", "b", "b_velocity", "c"],
  "properties"           : {
    "$schema"             : { "type": ["string", "null"] },
    "name"                : { "type": "string", "minLength": 1 },
    "description"         : { "type": "string", "minLength": 1 },
    "kind"                : { "enum": ["fixed-runge-kutta-nystrom", "adaptive-runge-kutta-nystrom"] },
    "order"               : { "type": "integer", "minimum": 1 },
    "A"                   : { "$ref": "#/$defs/matrix" },
    "A_velocity"          : { "oneOf": [{ "$ref": "#/$defs/matrix" }, { "type": "null" }] },
    "b"                   : { "$ref": "#/$defs/vector" },
    "b_velocity"          : { "$ref": "#/$defs/vector" },
    "c"                   : { "$ref": "#/$defs/vector" },
    "error"               : { "oneOf": [{ "$ref": "#/$defs/vector" }, { "type": "null" }] },
    "velocity_error"      : { "oneOf": [{ "$ref": "#/$defs/vector" }, { "type": "null" }] },
    "position_only_error" : { "type": "boolean" },
    "dense"               : { "oneOf": [{ "$ref": "#/$defs/matrix" }, { "type": "null" }] },
    "velocity_dense"      : { "oneOf": [{ "$ref": "#/$defs/matrix" }, { "type": "null" }] }
  },
  "$defs"                : {
    "scalar" : { "oneOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }] },
    "vector" : { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar" } },
    "matrix" : {
      "type"     : "array",
      "minItems" : 1,
      "items"    : { "$ref": "#/$defs/vector" }
    }
  }
}
