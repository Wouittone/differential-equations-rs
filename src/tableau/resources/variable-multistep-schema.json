{
  "$schema"              : "https://json-schema.org/draft/2020-12/schema",
  "title"                : "Canonical variable-step two-step tableau",
  "type"                 : "object",
  "additionalProperties" : false,
  "required"             : ["name", "description", "kind", "order", "alpha", "beta", "startup", "defect"],
  "properties"           : {
    "$schema"     : { "type": "string", "format": "uri-reference" },
    "name"        : { "type": "string", "minLength": 1 },
    "description" : { "type": "string", "minLength": 1 },
    "kind"        : { "const": "variable-linear-multistep" },
    "order"       : { "type": "integer", "minimum": 1, "maximum": 4 },
    "alpha"       : { "$ref": "#/$defs/coefficient-vector" },
    "beta"        : { "$ref": "#/$defs/coefficient-vector" },
    "startup"     : {
      "type"                 : "object",
      "additionalProperties" : false,
      "required"             : ["order", "alpha", "beta"],
      "properties"           : {
        "order" : { "type": "integer", "minimum": 1 },
        "alpha" : { "$ref": "#/$defs/fixed-vector" },
        "beta"  : { "$ref": "#/$defs/fixed-vector" }
      }
    },
    "defect"      : {
      "type"                 : "object",
      "additionalProperties" : false,
      "required"             : ["derivative_weights", "scale"],
      "properties"           : {
        "derivative_weights" : { "$ref": "#/$defs/coefficient-vector" },
        "scale"              : { "$ref": "#/$defs/ratio-coefficient" }
      }
    }
  },
  "$defs"                : {
    "scalar"             : { "oneOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }] },
    "polynomial"         : { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar" } },
    "ratio-coefficient"  : {
      "oneOf" : [
        { "$ref": "#/$defs/polynomial" },
        {
          "type"                 : "object",
          "additionalProperties" : false,
          "required"             : ["numerator", "denominator"],
          "properties"           : {
            "numerator"   : { "$ref": "#/$defs/polynomial" },
            "denominator" : { "$ref": "#/$defs/polynomial" }
          }
        }
      ]
    },
    "coefficient-vector" : {
      "type"     : "array",
      "minItems" : 3,
      "maxItems" : 3,
      "items"    : { "$ref": "#/$defs/ratio-coefficient" }
    },
    "fixed-vector"       : {
      "type"     : "array",
      "minItems" : 2,
      "maxItems" : 2,
      "items"    : { "$ref": "#/$defs/scalar" }
    }
  }
}
