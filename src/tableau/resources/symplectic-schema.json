{
  "$schema"              : "https://json-schema.org/draft/2020-12/schema",
  "title"                : "Differential equations symplectic composition tableau",
  "description"          : "Alternating position drift b[i] followed by velocity kick a[i].",
  "type"                 : "object",
  "additionalProperties" : false,
  "required"             : ["name", "description", "kind", "order", "a", "b"],
  "properties"           : {
    "$schema"     : { "type": "string", "format": "uri-reference" },
    "name"        : { "type": "string", "minLength": 1 },
    "description" : { "type": "string", "minLength": 1 },
    "kind"        : { "const": "symplectic-composition" },
    "order"       : { "type": "integer", "minimum": 1 },
    "a"           : { "$ref": "#/$defs/vector" },
    "b"           : { "$ref": "#/$defs/vector" }
  },
  "$defs"                : {
    "scalar" : { "oneOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }] },
    "vector" : { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scalar" } }
  }
}
